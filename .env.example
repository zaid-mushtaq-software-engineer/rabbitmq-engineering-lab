# Copy to .env in the repository root or export before: docker compose -f docker/docker-compose.yml up -d

RABBITMQ_USER=lab_app
RABBITMQ_PASSWORD=change_me_rabbit

MYSQL_ROOT_PASSWORD=change_me_root

# Used by Spring Boot apps (local profile)
SPRING_RABBITMQ_USERNAME=lab_app
SPRING_RABBITMQ_PASSWORD=change_me_rabbit

SPRING_DATASOURCE_CONSUMER_URL=jdbc:mysql://localhost:3306/notification_lab?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_CONSUMER_USERNAME=lab_consumer
SPRING_DATASOURCE_CONSUMER_PASSWORD=change_me_consumer

SPRING_DATASOURCE_PRODUCER_URL=jdbc:mysql://localhost:3306/notification_lab?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_PRODUCER_USERNAME=lab_producer
SPRING_DATASOURCE_PRODUCER_PASSWORD=change_me_producer
